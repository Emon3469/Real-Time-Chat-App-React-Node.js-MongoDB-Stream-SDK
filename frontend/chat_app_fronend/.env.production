VITE_STREAM_API_KEY=mmchq2emh4s5
# VITE_API_URL is intentionally left unset for a monolithic Render deployment.
# When unset, Axios falls back to the relative "/api" path, so all API calls
# hit the same Render service that serves the frontend — no CORS issues, no
# hardcoded URLs that break on redeploy.
# Only set VITE_API_URL if your frontend and backend are on SEPARATE domains.
